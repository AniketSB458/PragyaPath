# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_API_KEY: (Optional) Google API key with YouTube Data API v3 enabled.
# If not explicitly provided, GEMINI_API_KEY is used or Gemini Search Grounding discovers verified web/YouTube resources.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: (Optional) MongoDB connection string for MongoDB Atlas or local MongoDB instance.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pragyapath?retryWrites=true&w=majority
# If not provided, an integrated persistent MongoDB document store is automatically activated.
MONGODB_URI="mongodb://localhost:27017/pragyapath"

